# --- Database ---
DATABASE_URL=postgresql+psycopg://btc_user:btc_password@timescaledb:5432/btc_intelligence

# --- Exchange (para el market data fetcher, vía ccxt) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
BINANCE_MARKET_TYPE=USDT-M
# Mantener true hasta validar la integración en Binance Futures Testnet.
BINANCE_TESTNET=true
# Interruptor independiente: false bloquea cualquier orden privada.
BINANCE_LIVE_TRADING=false
BINANCE_MAX_ORDER_NOTIONAL_USDT=100
BINANCE_ALLOWED_SYMBOLS=BTC/USDT:USDT
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAMES=5m,15m,1h,4h,1d

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_CHAT_MODEL=gemma2:2b
AI_CREATOR_NAME=Jonathan Paniagua Vazquez
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Fase 4: Knowledge Center + RAG ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=btc_knowledge
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
DOCUMENTS_STORAGE_PATH=/app/storage/documents

# --- Fase 4b: Biblioteca local ---
LIBRARY_PATH=/app/storage/library
LIBRARY_SCAN_INTERVAL_MINUTES=10
